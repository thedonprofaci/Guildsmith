# Guildsmith configuration. Every setting is an environment variable (spec section 5).
# This file holds placeholders only: never commit a real token. For local development use
# `dotnet user-secrets` (read only when DOTNET_ENVIRONMENT=Development) or your shell.

# Required. The bot token of your Discord application.
DISCORD_TOKEN=<your-bot-token>

# Required. Comma-separated guild (server) IDs the tools may act on. Empty: the server does not start.
ALLOWED_GUILD_IDS=<guild-id>,<another-guild-id>

# ReadOnly or ReadWrite. Default: ReadWrite.
DISCORD_MCP_MODE=ReadWrite

# true or false. Allows deletes, permission changes, kick and ban. Default: false.
ALLOW_DESTRUCTIVE=false

# true or false. Allows granting a role with the Administrator permission. Default: false.
ALLOW_ADMIN_GRANT=false

# 1 to 100. The most messages one read returns. Default: 50.
MAX_MESSAGES_PER_READ=50

# stdio. (http is phase 3 and is rejected at startup.) Default: stdio.
MCP_TRANSPORT=stdio

# Trace, Debug, Information, Warning, Error, Critical or None. Default: Information.
LOG_LEVEL=Information
