  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Guildsmith.Core\Guildsmith.Core.csproj" />
    <ProjectReference Include="..\..\src\Guildsmith.Discord\Guildsmith.Discord.csproj" />
    <ProjectReference Include="..\..\src\Guildsmith.Server\Guildsmith.Server.csproj" />
